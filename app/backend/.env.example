# Copy to .env (same folder). Real environment variables override these.

# --- Staff login (clinician side: queue, session detail, PDF) ---
# Format: username:password[:Display name], comma separated.
# CHANGE THESE before using the kiosk anywhere real.
STAFF_ACCOUNTS=nurse:nurse2026:Nurse on duty,doctor:doctor2026:Duty clinician
# Secret used to sign login tokens. Leave empty to auto-generate on each start
# (everyone is logged out after a restart). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
TOKEN_TTL_MINUTES=480

# --- Frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional AI layers (all degrade gracefully when offline/unavailable) ---
ENABLE_HF_NER=true
HF_NER_MODEL_NAME=d4data/biomedical-ner-all
# Avatar "AI voice" (server-side TTS, VITS). Other languages: facebook/mms-tts-fra, facebook/mms-tts-ara.
# The device voice is used automatically when this is unavailable.
TTS_MODEL_NAME=facebook/mms-tts-eng
# Server-side speech-to-text fallback for browsers without built-in recognition.
STT_MODEL_NAME=openai/whisper-tiny
# Leave empty to auto-detect the spoken language, or force one: en, fr, ar ...
STT_LANGUAGE=
